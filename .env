DOMAIN=${DOMAIN:-mac.example.com}
TOP=${TOP:-${PWD}}
LDAP_USERS=yash,zarkesh,blessing,moe,larry,curly
VAULT_IMAGE=${VAULT_IMAGE:-hashicorp/vault-enterprise}
VAULT_VERSION=${VAULT_VERSION:-1.20.0-ent}
TERRAFORM_IMAGE=${TERRAFORM_IMAGE:-hashicorp/terraform}
TERRAFORM_VERSION=${TERRAFORM_VERSION:-1.12.2}
TRAEFIK_IMAGE=${TRAEFIK_IMAGE:-traefik}
TRAEFIK_VERSION=${TRAEFIK_VERSION:-v3.4}
OPENLDAP_IMAGE=${OPENLDAP_IMAGE:-bitnami/openldap}
OPENLDAP_VERSION=${OPENLDAP_VERSION:-2.6.6}
